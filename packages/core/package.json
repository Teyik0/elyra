{
  "name": "@teyik0/furin",
  "version": "0.2.0-alpha.5",
  "description": "React meta-framework powered by Elysia and Bun with file-based routing, SSR, SSG, and ISR.",
  "license": "MIT",
  "author": "teyik0",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "react",
    "furin",
    "framework",
    "elysia",
    "bun",
    "ssr",
    "ssg",
    "routing",
    "file-based-routing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teyik0/furin.git"
  },
  "bugs": {
    "url": "https://github.com/teyik0/furin/issues"
  },
  "homepage": "https://github.com/teyik0/furin#readme",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/furin.js",
  "module": "./dist/furin.js",
  "types": "./dist/furin.d.ts",
  "bin": {
    "furin": "./src/cli/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/furin.d.ts",
      "bun": "./src/furin.ts",
      "import": "./dist/furin.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "bun": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "browser": "./src/rsc-client.ts",
      "bun": "./src/rsc.tsx",
      "import": "./dist/rsc.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "bun": "./src/build/index.ts",
      "import": "./dist/build/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "bun": "./src/config.ts",
      "import": "./dist/config.js"
    },
    "./router": {
      "types": "./dist/server/router/index.d.ts",
      "bun": "./src/server/router/index.ts",
      "import": "./dist/server/router/index.js"
    },
    "./strip-plugin": {
      "types": "./dist/plugin/index.d.ts",
      "bun": "./src/plugin/index.ts",
      "import": "./dist/plugin/index.js"
    },
    "./link": {
      "types": "./dist/client/link.d.ts",
      "bun": "./src/client/link.tsx",
      "import": "./dist/client/link.js"
    },
    "./search": {
      "types": "./dist/client/router/search/index.d.ts",
      "bun": "./src/client/router/search/index.ts",
      "import": "./dist/client/router/search/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "bun": "./src/env.d.ts"
    },
    "./internal": {
      "types": "./dist/server/internal.d.ts",
      "bun": "./src/server/internal.ts",
      "import": "./dist/server/internal.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "bun": "./src/server-only.ts",
      "import": "./dist/server-only.js"
    },
    "./client-only": {
      "types": "./dist/client-only.d.ts",
      "bun": "./src/client-only.ts",
      "import": "./dist/client-only.js"
    }
  },
  "scripts": {
    "benchmark:rsc": "bun scripts/benchmark-rsc-transport.ts",
    "fix": "ultracite fix",
    "test": "FURIN_RSC_CODEC_PATH=./dist/rsc/server-codec.js bun test tests/architecture/layering.test.ts tests/auto-invalidate.test.ts tests/await.test.tsx tests/build-embed.test.ts tests/cli-config.test.ts tests/defer.test.ts tests/deferred-abort.test.ts tests/deferred-client.test.ts tests/deferred-hydration-race.test.ts tests/deferred-loaders.test.ts tests/deferred-rejection.test.ts tests/deferred-render.test.ts tests/dev-hmr-cache-invalidation.integration.test.ts tests/dev-hmr-parent-child.integration.test.ts tests/dev-hmr.integration.test.ts tests/dev-page-plugin.test.ts tests/error-boundary-navigation.test.tsx tests/ppr.test.tsx tests/react-singleton-integration.test.ts tests/render-boundaries.test.tsx tests/render-digest.test.ts tests/render-element-boundaries.test.tsx tests/render-template.test.ts tests/route-cache.test.ts tests/route-types.test.ts tests/rsc-build.test.ts --parallel=2 --isolate --bail --timeout 30000 --preload ../../tests/setup.ts",
    "test:dev": "FURIN_RSC_CODEC_PATH=./dist/rsc/server-codec.js bun test --changed --parallel=2 --isolate --bail --timeout 30000 --preload ../../tests/setup.ts",
    "tscheck": "tsc --noEmit",
    "build": "bun run build.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.7",
    "@elysiajs/static": "^1.4.10",
    "magic-string": "^0.30.21",
    "react-server-dom-webpack": "19.2.7",
    "seroval": "^1.5.4"
  },
  "devDependencies": {
    "@yuku-toolchain/types": "0.5.42",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "expect-type": "^1.4.0"
  },
  "peerDependencies": {
    "elysia": "catalog:",
    "evlog": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
