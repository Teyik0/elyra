{
  "name": "@teyik0/furin",
  "version": "0.3.0-alpha.1",
  "description": "React meta-framework powered by Elysia and Bun with file-based routing, SSR, SSG, and ISR.",
  "license": "MIT",
  "author": "teyik0",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "react",
    "furin",
    "framework",
    "elysia",
    "bun",
    "ssr",
    "ssg",
    "routing",
    "file-based-routing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teyik0/furin.git"
  },
  "bugs": {
    "url": "https://github.com/teyik0/furin/issues"
  },
  "homepage": "https://github.com/teyik0/furin#readme",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/furin.js",
  "module": "./dist/furin.js",
  "types": "./dist/furin.d.ts",
  "bin": {
    "furin": "./src/cli/index.ts",
    "furin-sync-postgres-migrate": "./dist/server/sync/postgres/migrate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/furin.d.ts",
      "bun": "./src/furin.ts",
      "import": "./dist/furin.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "bun": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "browser": "./src/rsc-client.ts",
      "bun": "./src/rsc.tsx",
      "import": "./dist/rsc.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "bun": "./src/build/index.ts",
      "import": "./dist/build/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "bun": "./src/config.ts",
      "import": "./dist/config.js"
    },
    "./router": {
      "types": "./dist/server/router/index.d.ts",
      "bun": "./src/server/router/index.ts",
      "import": "./dist/server/router/index.js"
    },
    "./sync": {
      "types": "./dist/server/sync/index.d.ts",
      "bun": "./src/server/sync/index.ts",
      "import": "./dist/server/sync/index.js"
    },
    "./sync/postgres": {
      "types": "./dist/server/sync/postgres/index.d.ts",
      "bun": "./src/server/sync/postgres/index.ts",
      "import": "./dist/server/sync/postgres/index.js"
    },
    "./sync/postgres/migration.sql": "./src/server/sync/postgres/migration.sql",
    "./sync/redis": {
      "types": "./dist/server/sync/redis/index.d.ts",
      "bun": "./src/server/sync/redis/index.ts",
      "import": "./dist/server/sync/redis/index.js"
    },
    "./sync/sqlite": {
      "types": "./dist/server/sync/sqlite/index.d.ts",
      "bun": "./src/server/sync/sqlite/index.ts",
      "import": "./dist/server/sync/sqlite/index.js"
    },
    "./sync/sqlite/migration.sql": "./src/server/sync/sqlite/migration.sql",
    "./strip-plugin": {
      "types": "./dist/plugin/index.d.ts",
      "bun": "./src/plugin/index.ts",
      "import": "./dist/plugin/index.js"
    },
    "./link": {
      "types": "./dist/client/link.d.ts",
      "bun": "./src/client/link.tsx",
      "import": "./dist/client/link.js"
    },
    "./search": {
      "types": "./dist/client/router/search/index.d.ts",
      "bun": "./src/client/router/search/index.ts",
      "import": "./dist/client/router/search/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "bun": "./src/env.d.ts"
    },
    "./internal": {
      "types": "./dist/server/internal.d.ts",
      "bun": "./src/server/internal.ts",
      "import": "./dist/server/internal.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "bun": "./src/server-only.ts",
      "import": "./dist/server-only.js"
    },
    "./client-only": {
      "types": "./dist/client-only.d.ts",
      "bun": "./src/client-only.ts",
      "import": "./dist/client-only.js"
    }
  },
  "scripts": {
    "fix": "ultracite fix",
    "test": "bun test --parallel --isolate --bail",
    "test:dev": "bun test --changed --parallel --isolate --bail",
    "tscheck": "tsc --noEmit",
    "build": "bun run build.ts",
    "benchmark:rsc": "bun scripts/benchmark-rsc-transport.ts"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.10",
    "@yuku-toolchain/types": "0.6.1",
    "magic-string": "^0.30.21",
    "react-server-dom-webpack": "19.2.7",
    "seroval": "^1.5.5",
    "yuku-parser": "0.6.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "expect-type": "^1.4.0"
  },
  "peerDependencies": {
    "elysia": "catalog:",
    "evlog": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
